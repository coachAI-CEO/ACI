{
  "name": "api",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand src/__tests__/club-session-scope.test.ts src/__tests__/tactical-boards.authz.test.ts src/__tests__/tactical-boards.http.test.ts src/__tests__/tactical-board-drawing.test.ts src/__tests__/tactical-board-scenario.test.ts src/__tests__/board-lines.test.ts src/__tests__/board-ai-followup.test.ts src/__tests__/board-card-meta.test.ts src/__tests__/board-combo-composer.test.ts src/__tests__/board-playout-nine.test.ts",
    "test:all": "jest --runInBand",
    "dev": "nodemon --watch src -e ts,js,json --exec \"ts-node --project tsconfig.json src/index.ts\"",
    "build": "prisma migrate deploy && prisma generate && tsc",
    "start": "node dist/apps/api/src/index.js",
    "bulk:sessions": "ts-node --project tsconfig.json src/scripts/generate-bulk-sessions.ts",
    "bulk:series": "ts-node --project tsconfig.json src/scripts/generate-bulk-series.ts",
    "preview:session-pdf": "ts-node --transpile-only --project tsconfig.json src/scripts/preview-session-pdf.ts",
    "sandbox:diagram": "ts-node --project tsconfig.json src/scripts/diagram-sandbox.ts",
    "sandbox:first-pass": "ts-node --project tsconfig.json src/scripts/first-pass-diagrams/run.ts",
    "sandbox:pattern-hunt": "ts-node --project tsconfig.json src/scripts/pattern-hunt/run.ts",
    "sandbox:pattern-hunt:pass2": "ts-node --project tsconfig.json src/scripts/pattern-hunt/pass2.ts",
    "vault:redraw-diagrams": "ts-node --project tsconfig.json src/scripts/redraw-vault-diagrams.ts",
    "sandbox:first-pass:until": "ts-node --project tsconfig.json src/scripts/first-pass-diagrams/run.ts -- --visual --until-confidence 75 --max-rounds 3",
    "sandbox:session-quality": "ts-node --project tsconfig.json src/scripts/session-quality-sandbox.ts",
    "sandbox:session-panel": "ts-node --project tsconfig.json src/scripts/session-panel/run.ts",
    "sandbox:scene-thesis": "ts-node --project tsconfig.json src/scripts/scene-thesis/compare.ts",
    "sandbox:scene-thesis:bench": "ts-node --project tsconfig.json src/scripts/scene-thesis/bench.ts",
    "sandbox:models": "ts-node --project tsconfig.json src/scripts/model-sandbox/run.ts",
    "sandbox:models:report": "ts-node --project tsconfig.json src/scripts/model-sandbox/report.ts",
    "backfill:club-memberships": "ts-node --project tsconfig.json src/scripts/backfill-club-memberships.ts",
    "seed:pilot-coaches": "ts-node --transpile-only --project tsconfig.json src/scripts/seed-pilot-coaches.ts",
    "seed:pilot-calendar": "ts-node --transpile-only --project tsconfig.json src/scripts/seed-pilot-calendar.ts",
    "seed:game-model-rocklin-fc": "ts-node --transpile-only --project tsconfig.json src/scripts/seed-game-model-rocklin-fc.ts",
    "scenario:board": "ts-node --transpile-only --project tsconfig.json src/scripts/scenario-tactical-board-editor.ts",
    "scenario:board-drawing": "ts-node --transpile-only --project tsconfig.json src/scripts/scenario-tactical-board-drawing.ts",
    "scenario:board-lines": "ts-node --transpile-only --project tsconfig.json src/scripts/scenario-tactical-board-lines.ts",
    "smoke:board": "ts-node --transpile-only --project tsconfig.json src/scripts/smoke-tactical-boards.ts",
    "tester:board-dsl": "ts-node --transpile-only --project tsconfig.json src/scripts/tester-board-symbolic-dsl.ts",
    "tester:board-dsl-chat": "ts-node --transpile-only --project tsconfig.json src/scripts/tester-board-dsl-chat.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.20.0",
  "dependencies": {
    "@aci/shared": "workspace:*",
    "@google/generative-ai": "^0.24.1",
    "@prisma/client": "^6.19.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pdfkit": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.7.3",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.12",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "stripe": "^20.3.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^7.0.5",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.19.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
