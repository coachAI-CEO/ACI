generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum GameModelId {
  COACHAI
  POSSESSION
  PRESSING
  TRANSITION
  ROCKLIN_FC
}

enum Phase {
  ATTACKING
  DEFENDING
  TRANSITION
  TRANSITION_TO_ATTACK
  TRANSITION_TO_DEFEND
}

enum Zone {
  DEFENSIVE_THIRD
  MIDDLE_THIRD
  ATTACKING_THIRD
}

enum SpaceConstraint {
  FULL
  HALF
  THIRD
  QUARTER
}

enum PlayerLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CoachLevel {
  USSF_D
  USSF_C
  USSF_B_PLUS
}

enum UserRole {
  FREE
  COACH
  CLUB
  ADMIN
  TRIAL
}

// A user's standing within one specific club, via ClubMembership -- kept
// separate from the global UserRole so a club can have zero, one, or many
// SECTION_DIRECTORs without a schema change either way. DOC sits at club
// scope (sectionId null); SECTION_DIRECTOR and COACH can optionally hang
// off a Section.
enum ClubRole {
  DOC
  SECTION_DIRECTOR
  COACH
}

enum SubscriptionPlan {
  FREE
  COACH_BASIC
  COACH_PRO
  CLUB_STANDARD
  CLUB_PREMIUM
  TRIAL
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR
  SUPPORT
}

enum DrillType {
  WARMUP
  TECHNICAL
  TACTICAL
  CONDITIONED_GAME
  FULL_GAME
  COOLDOWN
}

enum ArtifactType {
  DRILL
  SESSION
  MICROCYCLE
  MESOCYCLE
}

model Drill {
  id      String  @id @default(uuid())
  refCode String? @unique // Human-readable reference code (D-XXXX format)
  title   String

  // Tactical & psych metadata
  principleIds  Json? // array of strings
  psychThemeIds Json? // array of strings

  // Physical / conditioning
  energySystem String? // "ATP-PC" | "Anaerobic" | "Aerobic"
  rpeMin       Int?
  rpeMax       Int?

  // Session constraints
  numbersMin      Int?
  numbersMax      Int?
  spaceConstraint String?
  goalsAvailable  Int?
  goalMode        String?

  // Formation & level metadata
  formationUsed String?
  playerLevel   PlayerLevel?
  coachLevel    CoachLevel?

  // Drill type metadata
  drillType DrillType?

  // GK metadata
  needGKFocus Boolean? @default(false)
  gkFocus     String?

  gameModelId GameModelId
  phase       Phase
  zone        Zone
  ageGroup    String
  durationMin Int?
  qaScore     Float?
  approved    Boolean     @default(false)
  savedToVault Boolean    @default(false) // Vault system: mark drills saved to vault
  favoriteCount Int       @default(0)    // Number of users who favorited this drill

  json           Json
  visualThumbSvg String?
  visualHash     String? @unique
  diagramSvg              String?
  diagramSvgGeneratedAt   DateTime?
  diagramSvgModel         String?
  diagramSvgPromptVersion String?

  generatedBy    String?  // User ID who generated this drill
  user           User?    @relation("GeneratedDrills", fields: [generatedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qaReports QAReport[] @relation("DrillQAReports")
  
  @@index([refCode])
  @@index([savedToVault])
  @@index([gameModelId, ageGroup, phase, zone])
  @@index([generatedBy])
}

model Session {
  id      String  @id @default(uuid())
  refCode String? @unique // Human-readable reference code (S-XXXX or SR-XXXX format)
  title   String

  // Tactical & psych metadata
  principleIds  Json? // array of strings
  psychThemeIds Json? // array of strings

  // Physical / conditioning
  energySystem String? // "ATP-PC" | "Anaerobic" | "Aerobic"
  rpeMin       Int?
  rpeMax       Int?

  // Session constraints
  numbersMin      Int?
  numbersMax      Int?
  spaceConstraint String?
  goalsAvailable  Int?
  goalMode        String?

  // Formation & level metadata
  formationUsed String?
  playerLevel   PlayerLevel?
  coachLevel    CoachLevel?

  gameModelId GameModelId
  phase       Phase?
  zone        Zone?
  ageGroup    String
  durationMin Int? // Total session duration (60 or 90 minutes)
  qaScore     Float?
  approved    Boolean     @default(false)
  savedToVault Boolean    @default(false) // Vault system: mark sessions saved to vault
  isSeries    Boolean     @default(false) // Vault system: is this part of a series?
  seriesId     String?     // Vault system: if part of series, link to series group
  seriesNumber Int?        // Vault system: position in series (1, 2, 3, etc.)
  favoriteCount Int        @default(0)    // Number of users who favorited this session

  json           Json
  visualThumbSvg String?
  visualHash     String? @unique

  generatedBy    String?  // User ID who generated this session
  user           User?    @relation("GeneratedSessions", fields: [generatedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  qaReports QAReport[] @relation("SessionQAReports")
  skillFocuses SkillFocus[]
  
  @@index([refCode])
  @@index([savedToVault])
  @@index([isSeries, seriesId])
  @@index([gameModelId, ageGroup, phase, zone])
}

model SkillFocus {
  id         String   @id @default(uuid())
  sessionId  String?
  seriesId   String?
  sessionIds Json?
  title      String
  summary    String?
  keySkills  Json
  coachingPoints Json?
  psychologyGood Json?
  psychologyBad  Json?
  sectionPhrases Json?
  createdAt  DateTime @default(now())

  session Session? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([seriesId])
}

model QAReport {
  id           String       @id @default(uuid())
  artifactId   String
  artifactType ArtifactType @default(DRILL)
  drillId      String?
  sessionId    String?
  drill        Drill?       @relation("DrillQAReports", fields: [drillId], references: [id], onDelete: Cascade)
  session      Session?     @relation("SessionQAReports", fields: [sessionId], references: [id], onDelete: Cascade)
  pass         Boolean
  scores       Json
  summary      String?
  createdAt    DateTime     @default(now())

  @@index([artifactId, artifactType])
  @@index([drillId])
  @@index([sessionId])
}

model ArtifactEmbedding {
  id           String                @id @default(uuid())
  artifactType ArtifactType
  artifactId   String
  dims         Int
  embedding    Unsupported("vector")
  createdAt    DateTime              @default(now())

  @@index([artifactType, artifactId])
}

// Admin metrics tracking
model ApiMetrics {
  id              String   @id @default(uuid())
  
  // What was generated
  operationType   String   // "session", "drill", "series", "skill_focus", "qa_review"
  artifactId      String?  // Link to session/drill ID if applicable
  userId          String?  // Link to user who generated this (for usage tracking)
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  
  // LLM metrics
  model           String   // "gemini-3-flash-preview", "gemini-2.5-flash"
  promptTokens    Int?     // Input tokens
  completionTokens Int?    // Output tokens
  totalTokens     Int?     // Total tokens
  promptLength    Int      // Prompt character length
  responseLength  Int?     // Response character length
  
  // Timing
  durationMs      Int      // How long the API call took
  
  // Status
  success         Boolean  @default(true)
  errorMessage    String?
  
  // Metadata
  ageGroup        String?
  gameModelId     String?
  phase           String?
  
  createdAt       DateTime @default(now())
  
  @@index([operationType])
  @@index([createdAt])
  @@index([model])
  @@index([success])
  @@index([userId])
}

model VideoAnalysisCache {
  id                      String   @id @default(uuid())
  cacheKey                String   @unique
  sourceFileUri           String
  sourceFileUriNormalized String
  model                   String
  ageGroup                String
  playerLevel             String
  coachLevel              String
  gameModelId             String
  phase                   String
  zone                    String
  focusTeamColor          String
  opponentTeamColor       String
  minItems                Int
  maxItems                Int
  contract                Json
  analysis                Json
  fileUriUsed             String?
  hits                    Int      @default(0)
  lastHitAt               DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([sourceFileUriNormalized])
  @@index([createdAt])
  @@index([model])
}

model VideoAnalysisVault {
  id                String   @id @default(uuid())
  refCode           String?  @unique
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  title             String
  ageGroup          String
  playerLevel       String
  coachLevel        String
  gameModelId       String
  phase             String
  zone              String
  focusTeamColor    String
  opponentTeamColor String
  sourceFileUri     String?
  fileUriUsed       String?
  model             String?
  analysis          Json
  context           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([createdAt])
  @@index([gameModelId, phase, zone])
}

// Daily aggregated metrics for fast dashboard queries
model DailyMetrics {
  id              String   @id @default(uuid())
  date            DateTime @db.Date @unique
  
  // Counts
  totalApiCalls   Int      @default(0)
  successfulCalls Int      @default(0)
  failedCalls     Int      @default(0)
  
  // By operation type
  sessionsGenerated    Int @default(0)
  drillsGenerated      Int @default(0)
  seriesGenerated      Int @default(0)
  skillFocusGenerated  Int @default(0)
  qaReviewsRun         Int @default(0)
  
  // Tokens
  totalPromptTokens     Int @default(0)
  totalCompletionTokens Int @default(0)
  totalTokens           Int @default(0)
  
  // Timing
  totalDurationMs       Int @default(0)
  avgDurationMs         Int @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  @@index([date])
}

// User model with authentication and subscription support
model User {
  id        String     @id @default(uuid())
  email     String?    @unique  // Optional for backward compatibility, required for authenticated users
  passwordHash String? // bcrypt hashed password (null for anonymous users)
  name      String?
  
  // User role and subscription
  role              UserRole          @default(FREE)
  subscriptionPlan  SubscriptionPlan  @default(FREE)
  subscriptionStatus SubscriptionStatus @default(ACTIVE)
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  trialEndDate          DateTime? // For trial users
  
  // Profile
  coachLevel        CoachLevel?
  organizationName String?
  teamAgeGroups    String[] // Age groups they coach (e.g., ["U10", "U12"])

  // User preferences (defaults, notifications, etc.)
  preferences       Json?    // e.g. { defaultAgeGroup, emailSessionReminders }
  
  // Usage tracking
  sessionsGeneratedThisMonth Int @default(0)
  drillsGeneratedThisMonth   Int @default(0)
  lastResetDate              DateTime @default(now())
  
  // Email verification
  emailVerified    Boolean  @default(false)
  emailVerifiedAt  DateTime?
  
  // Activity tracking
  lastLoginAt      DateTime?
  
  // Access control
  blocked          Boolean   @default(false)
  blockedAt        DateTime?
  blockedReason    String?
  
  // Admin fields
  adminRole        AdminRole?
  adminNotes       String?
  lastAdminAction  DateTime?
  
  // Timestamps
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  
  // Relations
  favorites              Favorite[]
  refreshTokens          RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  adminActions           AdminAction[]
  userSessions           UserSession[]
  generatedSessions      Session[] @relation("GeneratedSessions")
  generatedDrills        Drill[] @relation("GeneratedDrills")
  apiMetrics             ApiMetrics[]
  videoAnalysisVaultItems VideoAnalysisVault[]
  playerPlans            PlayerPlan[]
  calendarEvents         CalendarEvent[]
  accessPermissions      AccessPermission[]
  passwordResetTokens    PasswordResetToken[]
  clubMemberships        ClubMembership[]
  grantedAccessPermissions AccessPermission[] @relation("AccessPermissionGrantedBy")
}

// Favorites - allows users to save sessions, drills, or series
model Favorite {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Polymorphic reference - only one will be set per favorite
  sessionId   String?  // References Session.id
  drillId     String?  // References Drill.id
  seriesId    String?  // References Session.seriesId for series groups
  
  createdAt   DateTime @default(now())
  
  // Ensure a user can only favorite each item once
  @@unique([userId, sessionId])
  @@unique([userId, drillId])
  @@unique([userId, seriesId])
  @@index([userId])
  @@index([sessionId])
  @@index([drillId])
  @@index([seriesId])
}

// Refresh tokens for JWT authentication
model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
}

// Email verification tokens
model EmailVerificationToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String   // Store email at time of token creation
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([token])
  @@index([email])
}

// Password reset tokens for "forgot password" flow
model PasswordResetToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([token])
}

// Audit log for admin actions
model AdminAction {
  id          String   @id @default(uuid())
  adminId     String
  admin       User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  
  action      String   // "user.deleted", "session.approved", "subscription.changed"
  resourceType String? // "User", "Session", "Drill", etc.
  resourceId   String? // ID of affected resource
  details      Json?    // Additional action details
  
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())
  
  @@index([adminId])
  @@index([action])
  @@index([resourceType, resourceId])
  @@index([createdAt])
}

// User sessions for analytics
model UserSession {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  
  @@index([userId])
  @@index([createdAt])
}

// Player-only training plans (adapted from sessions/series)
model PlayerPlan {
  id          String      @id @default(uuid())
  refCode     String?     @unique // P-XXXX format
  userId      String      // Who created/owns this plan
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Source reference
  sourceType  String      // "SESSION" | "SERIES"
  sourceId    String      // sessionId or seriesId
  sourceRefCode String?   // For easy lookup
  
  // Plan metadata
  title       String
  ageGroup    String
  playerLevel PlayerLevel? // Inherited from source session/series
  objectives  String?      // Short summary of what player will work on
  durationMin Int          // Total plan duration
  
  // Adapted content
  json        Json        // Array of solo drills with simplified instructions
  equipment   Json?       // Minimal equipment list (e.g., ["ball", "cones", "wall"])
  
  // Metadata
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  @@index([userId])
  @@index([sourceType, sourceId])
  @@index([refCode])
}

// Calendar events - scheduled training sessions
model CalendarEvent {
  id            String   @id @default(uuid())
  userId        String   // CURRENT owner/executor -- whoever's calendar this shows on right now.
                          // Every existing query already filters on this field, so reassignment
                          // (below) only ever changes userId itself; no other read path needs to change.
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // What session is scheduled
  sessionId     String   // References Session.id
  sessionRefCode String? // For easy reference

  // When it's scheduled
  scheduledDate DateTime // Date and time of the training session
  durationMin   Int?     // Override session duration if needed

  // Additional context
  notes         String?  // Coach notes for this specific session
  location      String?  // Training location (field, facility, etc.)
  teamName      String?  // Which team/group this is for

  // Status
  completed     Boolean  @default(false) // Mark as completed after session
  cancelled     Boolean  @default(false) // Mark as cancelled

  // Explicit reassignment/coverage trail (DOC Hub). originalCoachId is set
  // once, at creation, and never changes afterward -- it answers "whose
  // session was this originally," independent of who's covering it now.
  // assignedByUserId is who created this event, if it wasn't the coach
  // themself (a DOC/Section Director assigning a session onto a coach's
  // calendar). reassignedBy/reassignedAt record the most recent handoff.
  // All nullable: existing self-scheduled rows stay valid with no backfill.
  originalCoachId  String?   @map("original_coach_id")
  assignedByUserId String?   @map("assigned_by_user_id")
  reassignedBy     String?   @map("reassigned_by")
  reassignedAt     DateTime? @map("reassigned_at")

  // Metadata
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([scheduledDate])
  @@index([userId, scheduledDate])
}

// Access permissions for sessions and vault based on age group, format, coach level, or specific user
model AccessPermission {
  id          String   @id @default(uuid())
  
  // What this permission controls
  resourceType String   // "SESSION" | "VAULT" | "BOTH"
  
  // Who this applies to - either specific user OR coach level (mutually exclusive)
  userId       String?  // Specific user ID (if set, this permission applies only to this user)
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  coachLevel   CoachLevel? // Coach level (if userId is null, applies to all users with this coach level)
  
  // Age group restrictions
  ageGroups     String[] // Array of age groups (e.g., ["U8", "U9", "U10"]) - empty = all
  
  // Format restrictions (7v7, 9v9, 11v11)
  // Format is derived from age group: U8-U12 = 7v7, U13-U14 = 9v9, U15-U18 = 11v11
  formats       String[] // Array of formats (e.g., ["7v7", "9v9", "11v11"]) - empty = all
  
  // Access control
  canGenerateSessions Boolean @default(false) // Can generate new sessions
  canAccessVault      Boolean @default(false) // Can access vault (view and save)
  canAccessVideoReview Boolean @default(false) // Can access video review/analysis
  
  // Metadata
  notes         String?  // Admin notes about this permission
  createdBy     String?  // Admin user ID who created this (legacy free-text audit note, kept as-is)

  // Real FK version of createdBy, plus club scoping -- lets a DOC's grants
  // be checked against "does this granter actually manage this club" (the
  // old createdBy string was never read back anywhere, so nothing enforced
  // who could grant to whom). Both nullable: existing admin-created rows
  // have neither set and keep working exactly as before.
  createdByUserId String? @map("created_by_user_id")
  createdByUser   User?   @relation("AccessPermissionGrantedBy", fields: [createdByUserId], references: [id])
  clubId          String? @map("club_id")
  club            Club?   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([resourceType])
  @@index([userId])
  @@index([coachLevel])
  @@index([createdAt])
  @@index([clubId])
}

// Maps onto the pre-existing "clubs" table (previously managed entirely by
// hand-rolled raw SQL in services/clubs-store.ts -- see that file's
// CREATE TABLE for the columns this @map/@@map has to match exactly).
// Bringing it under Prisma lets everything below (Section, ClubMembership,
// AccessPermission.club, philosophy fields) use normal relations instead of
// more raw SQL. The migration for this model ALTERs the existing table
// in place; it must never attempt to CREATE TABLE "clubs" fresh.
model Club {
  id          String      @id @default(uuid())
  name        String
  code        String
  gameModelId GameModelId @map("game_model_id")
  description String?
  active      Boolean     @default(true)
  createdBy   String?     @map("created_by")

  // Club DNA -- the DOC's playing philosophy, authored per club and
  // threaded into session generation (replaces the old pattern of
  // hardcoding one club's philosophy as an if-branch in prompts/session.ts).
  // A club runs exactly one game model, so this lives on Club, not per-session.
  philosophyAttackingOrganization String?   @map("philosophy_attacking_organization")
  philosophyDefensiveTransition   String?   @map("philosophy_defensive_transition")
  philosophyDefensiveOrganization String?   @map("philosophy_defensive_organization")
  philosophyAttackingTransition   String?   @map("philosophy_attacking_transition")
  philosophyUpdatedAt             DateTime? @map("philosophy_updated_at")
  philosophyUpdatedBy             String?   @map("philosophy_updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships        ClubMembership[]
  sections            Section[]
  accessPermissions   AccessPermission[]

  // map: preserves the exact index names the raw-SQL table already has, so
  // this migration doesn't drop and recreate them under new names.
  @@unique([name], map: "clubs_name_unique_idx")
  @@index([active], map: "clubs_active_idx")
  @@map("clubs")
}

// System-level 4-moment DNA for each GameModelId. Clubs may override with
// Club.philosophy*; when club DNA is empty, session generation uses this
// template so every model has a real document — not only club-exclusive PDFs.
model GameModelTemplate {
  gameModelId                     GameModelId @id @map("game_model_id")
  label                           String
  summary                         String?
  exclusive                       Boolean     @default(false)
  attackingOrganization           String?     @map("attacking_organization") @db.Text
  defensiveTransition             String?     @map("defensive_transition") @db.Text
  defensiveOrganization           String?     @map("defensive_organization") @db.Text
  attackingTransition             String?     @map("attacking_transition") @db.Text
  updatedAt                       DateTime    @updatedAt @map("updated_at")
  updatedBy                       String?     @map("updated_by")

  @@map("game_model_templates")
}

// Optional per-club subdivision (an "age group," a "girls academy," whatever
// the club actually calls it -- free-text name, not a fixed enum, since
// every org's structure is different). A club with zero Sections and a club
// with five both use this same shape: coaches/directors just attach with
// sectionId null vs set.
model Section {
  id     String @id @default(uuid())
  clubId String @map("club_id")
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)
  name   String

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  memberships ClubMembership[]

  @@unique([clubId, name])
  @@index([clubId])
}

// A user's standing within one specific club. Deliberately a join table
// rather than folding ClubRole into the global UserRole enum -- that would
// force every club into the same DOC/coach shape. This lets a club opt into
// middle management (SECTION_DIRECTOR rows scoped to a Section) or skip it
// entirely (COACH rows with sectionId null, reporting straight to the DOC),
// per club, without a schema change either way.
model ClubMembership {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clubId    String   @map("club_id")
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  sectionId String?  @map("section_id")
  section   Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  role      ClubRole

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // One membership per user per club -- a person can't be both a COACH and
  // a SECTION_DIRECTOR in the same club at once under this model.
  @@unique([userId, clubId])
  @@index([clubId])
  @@index([sectionId])
  @@index([userId])
}
